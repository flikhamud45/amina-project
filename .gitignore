# Virtual environment -- recreate with requirements.txt, do not ship
.venv/

# Downloaded datasets and generated artifacts
code/data/
code/artifacts/models/
code/artifacts/results/
code/artifacts/figures/

# Extracted PDF text (regenerate from the PDFs).
# Anchored to the repo root: an unanchored `*.txt` also silently swallowed
# code/requirements.txt, which is why the pins the README promises were never
# actually committed.
/*.txt

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# LaTeX build products
*.aux
*.log
*.out
*.bbl
*.blg
*.synctex.gz

# Local cluster scratch (job logs, downloaded wheels); portable copies live in cluster/
.wheel_cache/
