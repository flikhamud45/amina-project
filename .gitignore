# Virtual environment -- recreate with code/requirements.txt
.venv/

# Downloaded datasets and caches (regenerable), and the benchmark's trained image models (not committed;
# experiments/costs/train_cnn.py trains them). The MNIST networks in code/artifacts/models/ are committed.
code/data/
code/artifacts/models/cnn/
code/artifacts/cache/

# SLURM job logs
/logs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# LaTeX build products
*.aux
*.log
# zkLLM's per-binary timings are records, not build logs
!code/artifacts/results/zkllm_l40s/*/bin_times.log
*.out
# The final run's stored records, job logs included
!code/artifacts/final/**
*.bbl
*.blg
*.xdv
*.fls
*.fdb_latexmk
*.synctex.gz
